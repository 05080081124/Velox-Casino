# Copy to .env and fill in. Never commit .env with real secrets.

SECRET_KEY=

# Optional: external odds line for bookmaking (The Odds API v4).
# Register at https://the-odds-api.com/ — key is NOT the same as other sports APIs.
# Enable feed in config/sport_odds_api.json ("enabled": true).
# Two providers (two keys): use sources[] in sport_odds_api.json — env_key names below.
SPORT_ODDS_API_KEY=
SPORT_ODDS_API_KEY_2=
# Alternative single-key env name:
THE_ODDS_API_KEY=

# Odds-API.io v3 (https://api.odds-api.io) — provider odds_api_io в sport_odds_api.json
ODDS_API_IO_KEY=
