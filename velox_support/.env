# ══════════════════════════════════════════════════════════════════
#  VELOX Support Panel — конфигурация
#  Скопируй этот файл в .env и заполни свои значения
# ══════════════════════════════════════════════════════════════════

# ── Сервер ─────────────────────────────────────────────────────────
SECRET_KEY=test
PORT=5001
DEBUG=true
HTTPS=false

# ── Ключ регистрации администратора ────────────────────────────────
ADMIN_REGISTER_KEY=testkey

# ── Никнейм по умолчанию ───────────────────────────────────────────
DEFAULT_ADMIN_NICKNAME=VELOX SUPPORT

# ══════════════════════════════════════════════════════════════════
#  DB_ENGINE — движок
#  sqlite      → локальная разработка (файлы .db)
#  postgresql  → продакшн (PostgreSQL / Supabase)
# ══════════════════════════════════════════════════════════════════
DB_ENGINE=sqlite

# ── SQLite пути ────────────────────────────────────────────────────
# localA_db — база АДМИНИСТРАТОРОВ (создаётся автоматически)
# localC_db — база КАЗИНО (укажи путь к casino.db от казино)
#
# Путь можно указать:
#   — абсолютный (рекомендуется для надёжности):
#       Windows: C:/Users/user/Desktop/product/fixed_out/database/casino.db
#       Linux:   /home/user/project/fixed_out/database/casino.db
#   — относительный от папки velox_support/:
#       ../fixed_out/database/casino.db
#
localA_db=../support_db/support.db
localC_db=../fixed_out/database/casino.db

# ── PostgreSQL / Supabase — БД КАЗИНО ──────────────────────────────
C_DB_HOST=localhost
C_DB_PORT=5432
C_DB_NAME=velox_casino
C_DB_USER=velox
C_DB_PASSWORD=velox_secret
C_DB_MIN_CONN=2
C_DB_MAX_CONN=10

# ── PostgreSQL / Supabase — БД АДМИНИСТРАТОРОВ ─────────────────────
A_DB_HOST=localhost
A_DB_PORT=5432
A_DB_NAME=velox_support
A_DB_USER=velox_support
A_DB_PASSWORD=support_secret
A_DB_MIN_CONN=1
A_DB_MAX_CONN=5

# ── Путь к конфигам казино (для otp_system.json fallback) ──────────
CASINO_CONFIG_PATH=../fixed_out/config
